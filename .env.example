# Application Environment Configuration
APP_ENV=development
API_PORT=8000
STREAMLIT_PORT=8501

# LLM Configuration
# Supports: gemini, openai, anthropic, or mock (built-in fallback for zero-cost testing)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gemini-1.5-flash

# Database Configuration
# PostgreSQL (Production/Docker): postgresql+psycopg://analyst_user:analyst_pass@localhost:5432/ecommerce_db
# SQLite (Local Dev fallback): sqlite:///./ecommerce.db
DATABASE_URL=sqlite:///./ecommerce.db

# Query Safety & Resource Limits
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=500
MAX_SQL_RETRIES=2
